# Local development
# DATABASE_URL=sqlite:///./agrobot.db

# Production runtime database. For Neon, the pooled connection string is suitable
# for normal app traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# Optional migration database. For Neon, use the direct/unpooled connection
# string here so Alembic does not run through PgBouncer.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

SECRET_KEY=replace-with-a-long-random-value
CORS_ORIGINS=https://your-frontend-domain.example
RUN_MIGRATIONS=false

GROQ_API_KEY=
OPENWEATHER_API_KEY=
# Development-only. When false, missing/failed weather returns unavailable
# instead of silently generating mock current conditions.
ENABLE_MOCK_WEATHER=false
CROP_MODEL_TOP_K=10
# Provisional product threshold; model probabilities are not calibrated.
CROP_MODEL_LOW_CONFIDENCE_THRESHOLD=0.15
# Uses XGBoost's native missing-value path when rainfall semantics are incompatible.
# Such results are always preliminary; no rainfall value is converted or invented.
ENABLE_PRELIMINARY_MODEL_WITH_MISSING_RAINFALL=true
# Provisional product-safety thresholds, pending agronomist validation.
MIN_RECOMMENDATION_SCORE=50
MIN_PRELIMINARY_SCORE=25
MIN_VERIFIED_CHECKS_FOR_RECOMMENDATION=4
ENABLE_LLM_EXPLANATIONS=true
GROQ_TIMEOUT_SECONDS=20
TAVILY_API_KEY=
AGMARKNET_API_KEY=
AGMARKNET_TIMEOUT_SECONDS=5
AGMARKNET_FAILURE_BACKOFF_SECONDS=60
# Disabled by default because subprocess fallback can block API workers.
AGMARKNET_ENABLE_CURL_FALLBACK=false
